# ============================================================
#  ShipIT Forge — environment configuration
#  Copy to .env and lock it down:   cp .env.example .env && chmod 600 .env
#  NEVER commit .env. Every secret stays here, not in the repo.
# ============================================================

# ---------- GitHub App (hosted server mode) ----------
# These three are written automatically if you register the App via the
# server's web page (open http://SERVER:3000), or copy them from the App's
# Settings → General. Not required when running as a GitHub Action.
APP_ID=
WEBHOOK_SECRET=
# Paste the PEM as one line with literal \n between lines, e.g.
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
PRIVATE_KEY=
# ...or point to a key file instead of pasting:
# PRIVATE_KEY_PATH=/etc/shipit-forge/private-key.pem


# ---------- Provider selection ----------
# One of: vertex | anthropic | openai | bedrock | fake
LLM_PROVIDER=vertex


# ---------- Vertex AI Gemini  (active default) ----------
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-pro
# Path to the service-account JSON (needs the "Vertex AI User" role):
GOOGLE_APPLICATION_CREDENTIALS=/etc/shipit-forge/vertex-sa.json
# OR paste the whole JSON here instead of a path — the server writes it to a
# chmod-600 temp file at boot. Use ONE of GOOGLE_APPLICATION_CREDENTIALS / this.
# VERTEX_CREDENTIALS_JSON=


# ---------- Anthropic  (alternative) ----------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ---------- OpenAI  (alternative) ----------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o

# ---------- AWS Bedrock  (alternative) ----------
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_ACCESS_KEY_ID=AKIA...           # or use an attached IAM role
# AWS_SECRET_ACCESS_KEY=...


# ---------- Behavior defaults (set these per client org) ----------
# When to open fix PRs:
#   label  = only when an issue is labeled (safe default)
#   opened = attempt a PR on EVERY new issue (full auto)
#   off    = never auto-fix
FORGE_AUTO_FIX=label
# When to review PRs:  always | requested (only on /review or invite) | off
FORGE_AUTO_REVIEW=always
# Review thoroughness:  light | standard | deep
FORGE_REVIEW_DEPTH=standard
# Issue label that triggers a fix:
FORGE_TRIGGER_LABEL=agent-fix
# Force a model for ANY provider (else the provider default above is used):
# FORGE_MODEL=
# Force the test command (else auto-detected from the repo):
# FORGE_TEST_COMMAND=npm test
# Max agent tool-loop steps per run:
MAX_ITERATIONS=25
# Optional: merge an external SARIF scan into reviews:
# FORGE_SARIF_PATH=


# ---------- Bot identity (how it appears in the org) ----------
# The @handle people mention to invoke it — must match your App's slug:
FORGE_DISPLAY_HANDLE=shipit-forge
FORGE_DISPLAY_NAME=ShipIT Forge
# Git author email used on commits the bot pushes:
FORGE_GIT_EMAIL=shipit-forge@users.noreply.github.com


# ---------- Server ----------
PORT=3000
# DEV ONLY — receive webhooks on a laptop via smee.io. NEVER set in production.
# WEBHOOK_PROXY_URL=

# ── Usage dashboard (optional) ───────────────────────────────────────────────
# Records every run, turn, tool call and dollar. Off unless this is set.
# Point it at a PERSISTENT disk: accounts live in this file, and artifacts are
# written next to it in <same-dir>/artifacts.
# FORGE_USAGE_DB=/data/usage.db
#
# Then create an account — the password is asked for, never passed as an
# argument: `forge dashboard:user add <name>`
#
# Optional. A never-expiring key for scripts and CI. An account alone is
# enough for people, and can be revoked on its own.
# FORGE_DASHBOARD_TOKEN=
#
# Only if the dashboard page is served from a different origin than the API.
# FORGE_DASHBOARD_ORIGIN=
#
# See deploy/DASHBOARD.md.
